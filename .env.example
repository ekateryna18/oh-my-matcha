# ── Oh My Matcha — Variables d'environnement ──────────────────────────────────
# Copiez ce fichier en .env et remplissez les valeurs avant de lancer Docker.
#
#   cp .env.example .env
#
# ⚠️  Ne commitez JAMAIS le fichier .env (il est dans .gitignore)

# ── MongoDB ────────────────────────────────────────────────────────────────────
DB_USERNAME=ohmymatcha
DB_PASSWORD=changeme_mot_de_passe_fort
DB_NAME=oh_my_matcha

# ── JWT ────────────────────────────────────────────────────────────────────────
# Générez une clé aléatoire avec :  openssl rand -hex 32
JWT_SECRET=changeme_cle_jwt_tres_longue_et_aleatoire

# ── Environnement ──────────────────────────────────────────────────────────────
NODE_ENV=development
